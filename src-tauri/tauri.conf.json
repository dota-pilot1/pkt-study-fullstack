{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PKT Study Fullstack",
  "version": "0.1.16",
  "identifier": "com.cj.pkt.study.fullstack",
  "build": {
    "beforeDevCommand": "node scripts/prepare-tauri-dev.mjs && npm run dev",
    "devUrl": "http://localhost:4300",
    "beforeBuildCommand": "npm run build:tauri",
    "beforeBundleCommand": "node scripts/sign-tauri-native-macos.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PKT 프로젝트",
        "width": 1280,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "fullscreen": false,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": -100,
          "y": 0
        },
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "externalBin": ["binaries/node"],
    "resources": {
      "../dist/next/": "next"
    }
  }
}
